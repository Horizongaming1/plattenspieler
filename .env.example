# The low-latency PCM below constrains the USB capture buffer to 46 ms.
# Set AUDIO_DEVICE=plughw:CARD=CODEC,DEV=0 to bypass it for troubleshooting.
AUDIO_DEVICE=turntable_capture
AUDIO_INPUT_CHANNELS=2
AUDIO_INPUT_RATE=44100
ALSA_CAPTURE_DEVICE=hw:CARD=CODEC,DEV=0
ALSA_CAPTURE_CHANNELS=2
ALSA_CAPTURE_RATE=44100
ALSA_CAPTURE_PERIOD_SIZE=256
ALSA_CAPTURE_BUFFER_SIZE=2048

# Debian's audio group is often 29. Verify on OMV with: getent group audio
AUDIO_GROUP_ID=29
TURNTABLE_HOST_PATH=/srv/dev-disk-by-uuid-ed0cc40b-12e9-481a-9c82-203c8a67d732/turntable
TZ=Europe/Berlin

# RMS detector. Values are normalized 0.0-1.0.
RMS_ON_THRESHOLD=0.025
RMS_OFF_THRESHOLD=0.015
RMS_WINDOW_SECONDS=0.5
SILENCE_TIMEOUT_SECONDS=180
RMS_SAMPLE_RATE=16000
LEVEL_LOG_INTERVAL_SECONDS=10

# MQTT. Leave MQTT_USER/MQTT_PASSWORD empty if your broker permits anonymous access.
MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_CLIENT_ID=turntable-bridge
MQTT_STATE_TOPIC=home/turntable/state
MQTT_AVAILABILITY_TOPIC=home/turntable/availability
MQTT_DISCOVERY_ENABLE=false
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_DISCOVERY_OBJECT_ID=plattenspieler_aktiv
MQTT_DEVICE_NAME=Plattenspieler
MQTT_UNIQUE_ID=turntable_bridge_active

# Icecast receives the ffmpeg MP3 stream internally on port 8000.
ICECAST_HOST=icecast
ICECAST_PORT=8000
ICECAST_MOUNT=turntable.mp3
ICECAST_SOURCE_USER=source
ICECAST_SOURCE_PASSWORD=change-me-source-password
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=change-me-admin-password
ICECAST_RELAY_PASSWORD=change-me-relay-password
ICECAST_HOSTNAME=localhost
ICECAST_LOCATION=OMV
ICECAST_ADMIN_EMAIL=admin@example.local
ICECAST_QUEUE_SIZE=131072
ICECAST_BURST_ON_CONNECT=0
ICECAST_BURST_SIZE=8192

# Public port exposed by Docker Compose. Stream URL:
# http://OMV-IP:8090/turntable.mp3
STREAM_PUBLIC_PORT=8090
STREAM_BITRATE=192k
STREAM_CHANNELS=2
STREAM_SAMPLE_RATE=44100

# Used by docker-compose.package.yml. Keep these defaults if the GitHub repo is
# Horizongaming1/plattenspieler.
TURNTABLE_IMAGE=ghcr.io/horizongaming1/plattenspieler-turntable:latest
ICECAST_IMAGE=ghcr.io/horizongaming1/plattenspieler-icecast:latest

FFMPEG_LOGLEVEL=warning
FFMPEG_LOW_LATENCY=true
FFMPEG_INPUT_QUEUE_SIZE=16
FFMPEG_RESTART_DELAY_SECONDS=5

# OwnTone runs as the NAS admin user by default on this OMV setup.
OWNTONE_IMAGE=docker.io/owntone/owntone:latest
OWNTONE_UID=1000
OWNTONE_GID=100
